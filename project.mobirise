    "Terms.html": {
      "settings": {
        "title": "Terms",
        "order": "1",
        "meta_descr": "Terms for Java Burn"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            ".mbr-section-title": {
